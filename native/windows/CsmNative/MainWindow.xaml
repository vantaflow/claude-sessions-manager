<Window x:Class="CsmNative.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Sessions" Height="820" Width="1320" Background="#1B1B1F">
  <Window.Resources>
    <SolidColorBrush x:Key="Fg" Color="#E6E6EA"/>
    <SolidColorBrush x:Key="Muted" Color="#9A9AA6"/>
    <SolidColorBrush x:Key="Panel" Color="#232329"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Background" Value="#2E2E36"/>
      <Setter Property="BorderBrush" Value="#3A3A44"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <DockPanel Background="{StaticResource Panel}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,6">
        <TextBlock Text="Sessions" Foreground="{StaticResource Fg}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Content="+ Nouvelle" Margin="12,0,0,0" Click="OnNew" ToolTip="Nouvelle session (Ctrl+Alt+N)"/>
      </StackPanel>
      <TextBox DockPanel.Dock="Top" x:Name="Search" Margin="10,0,10,6" Padding="4" TextChanged="OnSearch" ToolTip="Rechercher une session (nom, dossier, groupe)"/>
      <StackPanel DockPanel.Dock="Bottom" Margin="10,6">
        <TextBlock x:Name="QuotaText" Foreground="{StaticResource Muted}" FontSize="11"/>
        <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11"/>
      </StackPanel>
      <ListBox x:Name="List" Background="Transparent" BorderThickness="0" SelectionChanged="OnSelect"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ContextMenuOpening="OnMenu">
        <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" Foreground="#9A9AA6" FontSize="11" FontWeight="SemiBold" Margin="6,10,0,2"/>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4,3">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{Binding Dot}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Foreground="#E6E6EA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Text="{Binding Detail}" Foreground="#9A9AA6" FontSize="11" Margin="16,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="10,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="BtnRestart" Content="Reprendre" Click="OnRestart"/>
            <Button x:Name="BtnPause" Content="Pause" Click="OnPause"/>
            <Button x:Name="BtnClose" Content="Fermer" Click="OnClose" ToolTip="Retirée ici et sur tes autres machines ; la conversation reste dans l'Historique (Ctrl+Alt+W)"/>
          </StackPanel>
          <StackPanel>
            <TextBlock x:Name="Title" Foreground="{StaticResource Fg}" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock x:Name="Subtitle" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <ContentControl x:Name="TermHost" Margin="6"/>
    </DockPanel>
  </Grid>
</Window>
